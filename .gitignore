checkpoints/
indices/
*.sqlite
*.db

# TruLens databases
trulens_*.sqlite

# Notebook outputs and checkpoints
.ipynb_checkpoints/

# Coverage
.coverage
htmlcov/
coverage.xml

# Mypy
.mypy_cache/

# Ruff
.ruff_cache/

# pytest
