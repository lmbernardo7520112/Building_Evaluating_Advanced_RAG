{
  "contract_id": "experimental_readiness_contract_v1",
  "contract_version": 1,
  "status": "FROZEN_ACCEPTANCE_CONTRACT",
  "required_modules": [
    "raglab.agentic.experiments.contracts",
    "raglab.agentic.experiments.hashing",
    "raglab.agentic.experiments.path_policy",
    "raglab.agentic.experiments.receipt_store",
    "raglab.agentic.experiments.run_controller",
    "raglab.agentic.experiments.lineage_verifier"
  ],
  "required_symbols": [
    "RunState",
    "RunReceipt",
    "LineageAuditResult",
    "ExperimentalPathPolicy",
    "PathPolicyError",
    "RunReceiptStore",
    "ReceiptStoreError",
    "RunController",
    "RunControllerError",
    "LineageVerifier",
    "compute_file_sha256",
    "compute_canonical_json_sha256"
  ],
  "required_cli": [
    "scripts/prepare_agentic_run.py",
    "scripts/verify_agentic_run_lineage.py"
  ],
  "required_receipt_fields": [
    "schema_version",
    "run_id",
    "slice_id",
    "state",
    "artifact_root",
    "run_directory",
    "implementation_commit",
    "protocol_commit",
    "protocol_sha256",
    "input_hashes",
    "runner_version",
    "created_at_utc",
    "started_at_utc",
    "finished_at_utc",
    "exit_code",
    "artifact_inventory",
    "artifact_hashes",
    "previous_receipt_sha256",
    "receipt_sha256"
  ],
  "allowed_states": [
    "PREPARED",
    "RUN_STARTED",
    "RUN_COMPLETED",
    "AUDIT_COMPLETED",
    "FAILED"
  ],
  "allowed_transitions": [
    "PREPARED -> RUN_STARTED",
    "RUN_STARTED -> RUN_COMPLETED",
    "RUN_STARTED -> FAILED",
    "RUN_COMPLETED -> AUDIT_COMPLETED"
  ],
  "forbidden_transitions": [
    "PREPARED -> RUN_COMPLETED",
    "PREPARED -> AUDIT_COMPLETED",
    "RUN_STARTED -> AUDIT_COMPLETED",
    "RUN_COMPLETED -> RUN_STARTED",
    "AUDIT_COMPLETED -> PREPARED",
    "AUDIT_COMPLETED -> RUN_STARTED",
    "AUDIT_COMPLETED -> RUN_COMPLETED",
    "AUDIT_COMPLETED -> FAILED",
    "FAILED -> PREPARED",
    "FAILED -> RUN_STARTED",
    "FAILED -> RUN_COMPLETED",
    "FAILED -> AUDIT_COMPLETED"
  ],
  "terminal_states": [
    "AUDIT_COMPLETED",
    "FAILED"
  ],
  "forbidden_output_roots": [
    "/tmp",
    "/var/tmp",
    "repo_root",
    "repo_descendant",
    "relative_path",
    "empty_path",
    "benchmarks/",
    "checkpoints/"
  ],
  "forbidden_output_locations": [
    "/tmp",
    "/var/tmp",
    "benchmarks/",
    "checkpoints/",
    "repo_root"
  ],
  "required_directory_layout": [
    "<artifact_root>/<slice_id>/<run_id>/protocol.snapshot.json",
    "<artifact_root>/<slice_id>/<run_id>/run_receipt.json",
    "<artifact_root>/<slice_id>/<run_id>/receipts/",
    "<artifact_root>/<slice_id>/<run_id>/raw/",
    "<artifact_root>/<slice_id>/<run_id>/derived/",
    "<artifact_root>/<slice_id>/<run_id>/logs/",
    "<artifact_root>/<slice_id>/<run_id>/hashes.sha256"
  ],
  "required_preflight_checks": [
    "clean_tracked_git_tree",
    "empty_git_staging",
    "implementation_commit_exists",
    "protocol_commit_exists",
    "implementation_ancestor_of_protocol",
    "protocol_ancestor_of_head",
    "protocol_tracked_at_commit",
    "current_protocol_identical",
    "protocol_sha256_match",
    "inputs_exist",
    "inputs_sha256_match",
    "artifact_root_absolute_and_external",
    "run_id_unused",
    "run_directory_nonexistent"
  ],
  "required_atomicity_guarantees": [
    "temp_file_same_fs",
    "explicit_fsync_before_replace",
    "atomic_os_replace",
    "no_partial_receipt_on_failure"
  ],
  "required_locking_guarantees": [
    "exclusive_flock_on_run_dir",
    "concurrency_rejection",
    "lock_released_on_exit"
  ],
  "required_lineage_checks": [
    "receipt_chain_integrity",
    "protocol_snapshot_match",
    "input_hashes_match",
    "artifact_hashes_match",
    "no_unexpected_files",
    "verifier_read_only"
  ],
  "required_exit_codes": {
    "preflight_failure": "non-zero",
    "verifier_valid": 0,
    "verifier_invalid": "non-zero"
  },
  "secret_fields_forbidden": [
    "api_key",
    "secret",
    "token",
    "password",
    "credential",
    "bearer"
  ]
}
